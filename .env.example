port=3000

acess_token=

refresh_token=


# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=



supabaseurl=

project_url=

#pasword
SECRET_KEY=




# ── SMTP ─────────────────────────────────────────────────────────────────────
# One transport for every email the app sends (src/utils/mailer.js). Set these
# to move provider without touching code.
#
# SMTP_SECURE is derived from the port when left unset: true on 465 (implicit
# TLS), false on 587 (STARTTLS). Setting it true on 587 makes the connection
# hang until it times out.
#
# SMTP_USER/SMTP_PASSWORD fall back to EMAIL/EMAIL_PASSWORD below, so a
# deployment that predates this block keeps working on Gmail unchanged.
#
# Titan (what rivermossbooks.com uses):
#   SMTP_HOST=smtp.titan.email
#   SMTP_PORT=465
#   SMTP_SECURE=true
#SMTP_HOST=
#SMTP_PORT=
#SMTP_SECURE=
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
#SMTP_FROM_NAME=
#SMTP_REPLY_TO=

# Gmail fallback, used when SMTP_* above is unset. EMAIL_PASSWORD is a Gmail
# App Password, not the account password.
EMAIL=
EMAIL_PASSWORD=
FRONTEND_URL=http://localhost:3000



# MongoDB connection string. `mango_url` is kept for existing scripts; the app
# also accepts MONGO_URI, MONGODB_URI, MONGO_URL, and mongo_url.
mango_url=


# Images are stored on local disk and served from /uploads.
# Leave blank to use <repo>/uploads. In production point this at a mounted
# volume outside the deploy directory so a redeploy cannot wipe the catalogue,
# and back it up separately — db:backup does not cover the filesystem.
UPLOADS_DIR=


RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=demo
RAZORPAY_WEBHOOK_ENABLED=false
GOOGLE_CLIENT_ID=

# SHIPROCKET_ENABLED/SHIPPING_PROVIDER/SHIPROCKET_AUTO_CREATE_ORDER/
# SHIPROCKET_WEBHOOK_ENABLED are deploy-time switches —
# they stay here.
SHIPROCKET_ENABLED=false
SHIPPING_PROVIDER=shiprocket
SHIPROCKET_AUTO_CREATE_ORDER=false
SHIPROCKET_WEBHOOK_ENABLED=false

# Everything below (API login, pickup details, webhook token, default
# package size) is now editable live from Admin > Operations > Shipping —
# an admin-configured value there always wins. These env vars are only a
# fallback for a fresh deploy before anyone has opened that panel yet, so
# leaving them blank is fine once the admin panel has been used.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_DEFAULT_LENGTH_CM=10
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=10
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5

INVENTORY_ENFORCE_STOCK=true
INVENTORY_RESERVE_DURING_PAYMENT=true
# Seeds the initial value only — once the InventorySetting document exists
# (i.e. the first time anyone loads Admin > Inventory), an admin-set value
# there always wins and this is no longer read.
LOW_STOCK_THRESHOLD=5

AUTH_SECURITY_ENABLED=false
REFRESH_TOKEN_COOKIE_ENABLED=true
REFRESH_TOKEN_COOKIE_NAME=astromart_refresh_token
RATE_LIMIT_STORE=memory
REDIS_URL=

# NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_ENABLED=true
NOTIFY_SMS_ENABLED=false
NOTIFY_WHATSAPP_ENABLED=false
NOTIFY_PHONE_ENABLED=false

# Public storefront origin, used to build sitemap.xml and robots.txt.
# Falls back to FRONTEND_URL when unset.
SITE_URL=
