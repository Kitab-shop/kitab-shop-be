# ── Payments (Razorpay) — src/config/features.config.js `payments` ──
# Master switch. false = Razorpay checkout is unavailable; only Cash on
# Delivery works, and only if the admin-panel "Cash on Delivery" toggle
# (Admin > Operations > Checkout) is also on. CONFIRMED LIVE: with this false
# and Cash on Delivery also off (the admin-panel default), checkout has zero
# working payment method — verified by actually clicking through the
# storefront, not just reading the code. Set to true before any demo/testing
# that needs to place a real order through the UI.
PAYMENTS_ENABLED=true
# Only "razorpay" is actually implemented — isPaymentEnabled() requires this
# exact value in addition to PAYMENTS_ENABLED=true.
PAYMENT_PROVIDER=razorpay
# Read into config as payments.mode, but nothing in the codebase actually
# checks that value — it has no effect currently, "demo" or otherwise. What
# actually keeps this safe from a real charge is RAZORPAY_KEY_ID starting
# with rzp_test_ (Razorpay's own test/live key separation, not this app).
# Corrected here — an earlier version of this comment incorrectly implied
# PAYMENT_MODE itself gates real-vs-test charging.
PAYMENT_MODE=demo
# Whether POST /payment/razorpay/webhook processes Razorpay's webhook events
# at all. Also needs the webhook configured on Razorpay's own dashboard.
RAZORPAY_WEBHOOK_ENABLED=false

# ── Shipping (Shiprocket) — src/config/features.config.js `shipping` ──
# Master switch. false = every Shiprocket action (create shipment, AWB,
# pickup, label, invoice, live tracking) is blocked with a clean "disabled"
# response; order status must then be moved forward manually from the admin
# order-detail page instead of updating itself automatically.
# Note: Shiprocket also needs an email/password to actually log in — this
# file intentionally has no SHIPROCKET_EMAIL/SHIPROCKET_PASSWORD lines at
# all, since those are now set from Admin > Operations > Shipping and stored
# in the database instead (see ShiprocketSetting.model.js). If that panel has
# never been filled in, Shiprocket still can't be reached even with this
# flag on — but that's a database state to check, not something to look for
# in this file anymore.

SHIPROCKET_ENABLED=false
# SHIPROCKET_ENABLED=true

# Only "shiprocket" is actually implemented — isShippingEnabled() requires
# this exact value in addition to SHIPROCKET_ENABLED=true.
SHIPPING_PROVIDER=shiprocket
# If true, a Shiprocket order is created automatically right after a local
# order is placed, instead of requiring an admin to click "Create Shipment".
# SHIPROCKET_AUTO_CREATE_ORDER=false
SHIPROCKET_AUTO_CREATE_ORDER=true

# Restricts who can trigger Shiprocket actions to admin roles only.
SHIPROCKET_ADMIN_ONLY=true
# Whether incoming Shiprocket status-update webhooks are processed. Also
# needs SHIPROCKET_ENABLED=true — isShippingWebhookEnabled() checks both.
SHIPROCKET_WEBHOOK_ENABLED=false

# ── Inventory — src/config/features.config.js `inventory` ──
# If true, stock is actually checked and decremented at checkout (an order
# fails if there isn't enough). If false, stock numbers are cosmetic only.
INVENTORY_ENFORCE_STOCK=true
# If true, stock is temporarily reserved while a Razorpay payment is in
# progress, so two shoppers can't both "win" the last unit mid-checkout.
INVENTORY_RESERVE_DURING_PAYMENT=true
# Below this stock number, a product is flagged "low stock" in the admin.
# Now also editable live from the Inventory page (Admin > Inventory) — an
# admin-set value there always wins; this is only the fallback before that's
# ever been used.
LOW_STOCK_THRESHOLD=5

# Gates token revocation on logout/refresh, stricter signup/account-deletion/
# 2FA checks, and (redundantly with RATE_LIMIT_ENABLED, which already
# defaults on even when unset here) rate limiting. Off by default for easier
# local development.
AUTH_SECURITY_ENABLED=false

